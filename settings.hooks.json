{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/agent-instructions/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/agent-instructions/hooks/session-title.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/agent-instructions/hooks/scope-nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/agent-instructions/hooks/session-title.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/agent-instructions/hooks/format-on-edit.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/agent-instructions/hooks/review-trigger.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
